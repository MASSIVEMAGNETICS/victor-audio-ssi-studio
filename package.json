{
  "name": "victor-audio-ssi-studio",
  "version": "1.0.0",
  "description": "Next-generation audio synthesis and generation studio with integrated synthetic super intelligence",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc && tsc -p server/tsconfig.json",
    "build:core": "tsc",
    "build:server": "tsc -p server/tsconfig.json",
    "test": "jest",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "dev": "ts-node src/index.ts",
    "start": "node dist/index.js",
    "server": "ts-node server/src/server.ts",
    "server:prod": "node server/dist/server.js",
    "clean": "rm -rf dist server/dist"
  },
  "keywords": [
    "audio",
    "synthesis",
    "ai",
    "music",
    "studio",
    "quantum",
    "next-gen"
  ],
  "author": "MASSIVE MAGNETICS",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "web-audio-api": "^0.2.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.6",
    "@typescript-eslint/eslint-plugin": "^6.18.0",
    "@typescript-eslint/parser": "^6.18.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
